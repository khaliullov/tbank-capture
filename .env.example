# ==============================================================================
# T-Bank Capture Configuration (.env)
# ==============================================================================
# Скопируйте этот файл в .env и укажите ваши значения:
# cp .env.example .env

# --- Telegram Control Plane (Обязательные параметры) ---
# Токен бота Telegram, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш персональный числовой Chat ID в Telegram (получить можно у @userinfobot)
# Бот принимает команды исключительно от этого пользователя в личном чате.
TELEGRAM_CHAT_ID=987654321

# --- Browser & Profile Settings ---
# Директория постоянного профиля Chromium (сохраняет профиль между запусками)
USER_DATA_DIR=./data/browser-profile

# Запуск браузера:
# false — открыть видимое окно (рекомендуется для ручного входа и прохождения проверок)
# true  — запуск без графического интерфейса
HEADLESS=false

# --- Storage Directories ---
# Директория для сырых дампов ответов (используется только при DISCOVERY_RAW_CAPTURE=true)
RAW_CAPTURE_DIR=./data/raw

# Корневая директория для метаданных сессий и итоговых отчетов
DISCOVERY_DIR=./data/discovery

# --- Discovery Filters & Domains ---
# Разрешенные корневые домены через запятую (включая поддомены, например api.tbank.ru)
CAPTURE_ALLOWED_DOMAINS=tbank.ru,tinkoff.ru

# Сохранение сырых тел ответов на диск (true/false).
# ВНИМАНИЕ: По умолчанию false (только метаданные и схемы). Включайте только для отладки.
DISCOVERY_RAW_CAPTURE=false

# Максимальный размер тела ответа в байтах (по умолчанию 10 МБ = 10485760)
MAX_RESPONSE_BODY_BYTES=10485760

# Вместимость ограниченной очереди захвата
CAPTURE_QUEUE_SIZE=128

# Количество параллельных воркеров для обработки сетевых ответов Playwright
RESPONSE_WORKER_COUNT=8

# Вместимость очереди ответов перед воркерами
RESPONSE_QUEUE_SIZE=256

# --- JSON Structural Analysis Limits ---
# Максимальная глубина вложенности объектов JSON
MAX_JSON_DEPTH=32

# Максимальное количество анализируемых элементов в массивах
MAX_ARRAY_ELEMENTS=20

# Максимальное количество анализируемых полей в ответе
MAX_JSON_FIELDS=5000

# --- Logging ---
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info
